# Broker MQTT de la campaña 4G en la máquina virtual de Oracle Cloud
# (deploy/mosquitto_nube_tls.conf). Corre como el usuario ubuntu porque las
# llaves están en su carpeta; el servicio mosquitto del sistema queda
# deshabilitado. Instalación:
#   sudo cp deploy/systemd/mosquitto-ntcip.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mosquitto-ntcip
[Unit]
Description=Mosquitto TLS 1.3 + mTLS (broker de la campaña 4G, tesis PUCP)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/usr/sbin/mosquitto -c /home/ubuntu/ntcip_middleware/deploy/mosquitto_nube_tls.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
