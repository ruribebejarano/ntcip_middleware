# Bitácora de sesiones y planificación de curso/tesis: uso interno del
# autor, no son documentación técnica del proyecto. Se siguen escribiendo
# localmente (CLAUDE.md lo sigue pidiendo), pero no se publican en GitHub.
docs/bitacora/
docs/CRONOGRAMA.md
docs/PLAN_10H_2026-10-19.md
docs/PLAN_IMPLEMENTACION.md
docs/PREPARACION_REUNION_ASESOR.md
docs/prompt_consola_web.md
docs/prompt_repo_tailscale.md
docs/SERVICIOS_DEMOSTRACION.md

# resultados/: solo se versionan corridas curadas y documentadas
# (resultados/<escenario>/<AAAA-MM-DD_HHMM>/, ver resultados/LEEME.md).
# Estos son directorios de trabajo que se regeneran en cada corrida local
# o de scripts/demo_asesor.sh, no evidencia curada:
resultados/eventos/
resultados/rsu/
resultados/demo_combinado/
# cache de centro_control/panel/ (ver eventos_panel.py), se regenera solo:
resultados/panel_vivo/
resultados/obu_vivo/
resultados/demo_lazo_tmp/
# registro de auditoria de consola/ (ver docs/CONSOLA.md): se regenera solo,
# no es evidencia curada.
resultados/consola/
# lanzador de demos sin ventanas (scripts/demo/lanzar_rsus.ps1): logs,
# eventos y estado.json de cada corrida; se regeneran, no son evidencia curada.
resultados/demo/
# eventos crudos de una corrida de prueba en mesa (app_obu, sin GNSS real):
# se regenera, no es evidencia curada.
resultados/app_mesa/
# export para un tablero externo (claude.ai), generado desde las carpetas
# 20261029-* de resultados/campana/ -- no es evidencia curada, se regenera.
resultados/campana/_tablero/
# corrida multi-RSU del escenario Hospital del Niño (3 RSU): directorio de
# trabajo que se regenera (app_obu/pruebas/demo_hospital_nino.ps1 o la
# consola multi-RSU), no una corrida curada en resultados/<escenario>/<fecha>/.
resultados/hospital_nino/

# cache de descarga de osmnx/Overpass (scripts/datos/regenerar_grafo.py):
# se regenera solo; lo que SI se versiona es el .graphml ya cacheado en
# data/, no esta carpeta de respuestas crudas de la API.
cache/

# CA y certificados propios (scripts/seguridad/generar_ca.py, P4): son
# credenciales (la CA incluye la clave privada). Cada despliegue genera
# los suyos; nunca se commitea deploy/pki/.
deploy/pki/
# PKI de prueba del banco de seguridad local (scripts/seguridad/banco_local.py,
# prompt_seguridad.md S2): incluye claves privadas (incluso de casos
# negativos, como el certificado vencido/revocado) -- se regenera con
# "banco_local.py preparar", nunca se commitea.
deploy/pki_banco/
