# Copiar a .env (en la misma carpeta) y ajustar si hace falta.
# .env NO se commitea (ver .gitignore en la raiz del repo) -- antes estas
# credenciales vivian hardcodeadas en el codigo (agent/rsu_middleware.py,
# scripts/demo_asesor.sh, etc; esos archivos no se tocaron, siguen con
# las mismas credenciales de laboratorio embebidas, fuera del alcance de
# este cambio). Valores por defecto: credenciales de LABORATORIO, no usar
# en produccion.

SNMP_HOST=192.168.18.175
SNMP_PORT=1161
SNMP_USER=rsuLabUser
SNMP_AUTH_KEY=labAuthPass123
SNMP_PRIV_KEY=labPrivPass123

# Alias SSH de la Pi (ver ~/.ssh/config) -- usado por scripts/check_pi.sh,
# scripts/pi.sh, no directamente por este panel.
SSH_HOST_ALIAS=rsu
