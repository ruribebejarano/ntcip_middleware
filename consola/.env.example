# Copiar a consola/.env y ajustar si hace falta (no se commitea, ver .gitignore).
# Valores por defecto: banco de pruebas de laboratorio (ver CLAUDE.md).

# Broker MQTT (rsu/# y veh/#)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# RSU a supervisar por SNMPv3 (NTCIP 1202/1211) -- mismas credenciales de
# laboratorio que centro_control/panel/.env.
SNMP_HOST=rsu-01
SNMP_PORT=1161
SNMP_USER=rsuLabUser
SNMP_AUTH_KEY=labAuthPass123
SNMP_PRIV_KEY=labPrivPass123

# Identificador de esa RSU (ver RSU_ID en agent/rsu_middleware.py): selecciona
# que tema MQTT (rsu/<RSU_ID>/solicitudes) y que eventos_rsu_<RSU_ID>.csv /
# eventos_ctrl_<RSU_ID>.csv se leen por SSH.
RSU_ID=1

# Alias SSH de la Pi (ver ~/.ssh/config y docs/CONEXION_RASPBERRY.md) y
# carpeta del repo clonado ahi.
SSH_HOST_ALIAS=rsu
SSH_REMOTE_DIR=~/ntcip_middleware

# Donde escucha la consola (solo localhost por diseno: ver docs/CONSOLA.md).
CONSOLA_HOST=127.0.0.1
CONSOLA_PORT=8080
