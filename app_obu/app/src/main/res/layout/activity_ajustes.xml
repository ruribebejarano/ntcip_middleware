<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes en el orden en que se usan: conexión (lo que hay que dejar bien
     una vez y comprobar), misión, y al final lo de demo y mantenimiento.
     Se guardan solos al salir; "Listo" solo cierra. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== Conexión ===== -->
        <TextView
            style="@style/TituloSeccion"
            android:layout_marginTop="0dp"
            android:text="@string/conexion_titulo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_host" />
        <RadioGroup
            android:id="@+id/grupoHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/hostTailscale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ajustes_host_tailscale" />
            <RadioButton
                android:id="@+id/hostEmulador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/ajustes_host_emulador" />
            <RadioButton
                android:id="@+id/hostManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/ajustes_host_manual" />
        </RadioGroup>
        <EditText
            android:id="@+id/campoHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="100.121.77.97"
            android:inputType="textNoSuggestions" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ajustes_puerto" />
        <EditText
            android:id="@+id/campoPuerto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="8883"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ajustes_tls_titulo"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_tls_resumen"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/interruptorTls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ajustes_tls_activar" />

        <LinearLayout
            android:id="@+id/panelTls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoTlsEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ajustes_tls_sin_archivos"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonElegirTlsCa"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ajustes_tls_elegir_ca" />

                <Button
                    android:id="@+id/botonElegirTlsCert"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/ajustes_tls_elegir_cert" />

                <Button
                    android:id="@+id/botonElegirTlsKey"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/ajustes_tls_elegir_key" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/botonProbarConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tls_probar" />
        <TextView
            android:id="@+id/textoPruebaConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- ===== Misión ===== -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/seccion_mision_ajustes" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_clase" />
        <EditText
            android:id="@+id/campoClase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1"
            android:inputType="number" />

        <LinearLayout
            android:id="@+id/panelObuId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ajustes_obu_id" />
            <EditText
                android:id="@+id/campoObuId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="obu-tab-01"
                android:inputType="textNoSuggestions" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ajustes_obu_id_ayuda"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/textoObuIdTls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <Switch
            android:id="@+id/interruptorVibrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ajustes_vibrar" />

        <!-- ===== Demo ===== -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/seccion_demo_ajustes" />

        <Switch
            android:id="@+id/interruptorModoSimulado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_modo_simulado" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ajustes_avanzado" />
        <TextView
            android:id="@+id/textoTrayectoriaElegida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_sin_archivo"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botonElegirTrayectoria"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ajustes_elegir_trayectoria" />

            <Button
                android:id="@+id/botonUsarIntegrada"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/ajustes_quitar_archivo" />
        </LinearLayout>

        <!-- ===== Registro y batería ===== -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/seccion_registro_ajustes" />

        <Button
            android:id="@+id/botonExportarEventos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_exportar_eventos" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ajustes_bateria_resumen" />
        <Button
            android:id="@+id/botonRevisarBateria"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ajustes_bateria_boton" />

        <Button
            android:id="@+id/botonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ajustes_guardar" />

    </LinearLayout>
</ScrollView>
